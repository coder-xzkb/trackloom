{
  "manifest_version": 3,
  "name": "拾曲 Trackloom - 网易云歌单整理",
  "short_name": "拾曲 Trackloom",
  "version": "0.1.0",
  "description": "按实际演唱语种、歌曲类别或两者组合整理网易云音乐歌单",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://music.163.com/*",
    "https://music.163.com/*",
    "https://interface.music.163.com/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://music.163.com/*", "https://music.163.com/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["public/icons/*", "src/options/index.html"],
      "matches": ["http://music.163.com/*", "https://music.163.com/*"]
    }
  ]
}
